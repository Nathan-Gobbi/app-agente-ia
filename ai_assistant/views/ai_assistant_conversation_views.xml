<odoo>
    <record id="ai_assistant_conversation_view_list" model="ir.ui.view">
        <field name="name">ai.assistant.conversation.list</field>
        <field name="model">ai.assistant.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="write_date" />
            </list>
        </field>
    </record>

    <record id="ai_assistant_conversation_view_form" model="ir.ui.view">
        <field name="name">ai.assistant.conversation.form</field>
        <field name="model">ai.assistant.conversation</field>
        <field name="arch" type="xml">
            <form string="AI Assistant">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="user_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <separator string="Conversation" />
                    <field name="message_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="role" />
                            <field name="content" />
                            <field name="create_date" />
                        </list>
                    </field>
                    <separator string="Ask about your ERP" />
                    <field
                        name="question"
                        nolabel="1"
                        placeholder="Example: Which SKU sold the most on 25/06?"
                    />
                    <button
                        name="action_ask"
                        string="Ask assistant"
                        type="object"
                        class="btn-primary"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_assistant_conversation_action" model="ir.actions.act_window">
        <field name="name">AI Assistant</field>
        <field name="res_model">ai.assistant.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_conversations': 1}</field>
    </record>
</odoo>
