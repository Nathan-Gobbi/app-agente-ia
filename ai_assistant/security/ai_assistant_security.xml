<odoo>
    <record id="module_category_ai_assistant" model="ir.module.category">
        <field name="name">AI Assistant</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_ai_assistant_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_ai_assistant" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>

    <record id="ai_assistant_conversation_user_rule" model="ir.rule">
        <field name="name">AI conversations: own records</field>
        <field name="model_id" ref="model_ai_assistant_conversation" />
        <field
            name="domain_force"
        >[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant_user'))]" />
    </record>

    <record id="ai_assistant_message_user_rule" model="ir.rule">
        <field name="name">AI messages: own conversations</field>
        <field name="model_id" ref="model_ai_assistant_message" />
        <field
            name="domain_force"
        >[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant_user'))]" />
    </record>
</odoo>
